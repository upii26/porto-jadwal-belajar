CREATE TABLE IF NOT EXISTS lecturers (
    id SERIAL PRIMARY KEY,
    noDosen text NOT NULL,
    nama text NOT NULL,
    prodi text NOT NULL,
    email text NOT NULL,
    status text NOT NULL,
    created_at timestamptz DEFAULT CURRENT_TIMESTAMP,
    updated_at timestamptz,
    deleted_at timestamptz
);

